# TwinStock 環境變數設定
# 複製此檔為 .env，填入你的 Token 後存檔，start.sh / start.bat 會自動載入

# FinMind API Token（可至 https://finmindtrade.com/ 免費申請）
FINMIND_TOKEN=your_finmind_token_here

# Telegram Bot Token（由 @BotFather 取得）
TG_BOT_TOKEN=your_telegram_bot_token_here

# Telegram 聊天室 ID（-100xxxxxxxxxx 格式的群組 ID）
TG_CHAT_ID=your_telegram_chat_id_here

# 本地伺服器 Port（可選，預設 8080）
# PORT=8080
